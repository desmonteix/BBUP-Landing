# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# ---------------------------------------------------------------------------
# Supabase (Project Settings -> API)
# ---------------------------------------------------------------------------
# Safe to expose in the browser bundle (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-ONLY. Bypasses Row Level Security entirely — never prefix with
# NEXT_PUBLIC_, never send to the client. Used by src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Mercado Pago (https://www.mercadopago.com.pe/developers) — Checkout Pro,
# TEST credentials until a real merchant account exists (spec §10/§11: the
# user hasn't created one yet — signup as "persona natural" needs only DNI
# + a Peruvian bank account, no RUC). Find these under
# Tus integraciones -> [your app] -> Credenciales de prueba / producción.
# ---------------------------------------------------------------------------
# Public test key, safe in the browser bundle — not actually used directly
# by this app today (Checkout Pro is a server-created redirect, no client
# JS SDK needed), but Mercado Pago issues it alongside the access token and
# some future Bricks-based enhancement (e.g. an embedded card form) would
# need it, so it's wired up now.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000

# SERVER-ONLY. Used by src/lib/mercadopago.ts to create Checkout Pro
# preferences and to fetch payment status. Never expose this.
MERCADOPAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# Webhook secret signature ("Firma secreta") from Tus integraciones ->
# [your app] -> Webhooks. Used by src/app/api/mercadopago/webhook/route.ts
# to verify the x-signature header via the SDK's WebhookSignatureValidator.
MERCADOPAGO_WEBHOOK_SECRET=replace-with-the-secret-from-the-mp-dashboard

# ---------------------------------------------------------------------------
# Site URL — used to build Mercado Pago's back_urls/notification_url and
# the BCRP cron's own base URL. Must be a real, publicly-reachable HTTPS
# URL in production (Vercel sets VERCEL_URL automatically as a fallback,
# but setting this explicitly to your custom/production domain is safer).
# Note: testing the full Mercado Pago checkout redirect requires a
# publicly reachable URL — localhost won't work for back_urls/webhooks;
# use a tunnel (e.g. ngrok) or a Vercel preview deployment for that.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Vercel Cron protection — see vercel.json + src/app/api/cron/exchange-rate.
# Vercel automatically sends `Authorization: Bearer $CRON_SECRET` when it
# invokes a scheduled Cron Job if this env var is set. Generate any long
# random string.
# ---------------------------------------------------------------------------
CRON_SECRET=replace-with-a-long-random-string

# ---------------------------------------------------------------------------
# Resend (https://resend.com) — transactional email for RSVP/ticket
# confirmations. Free tier is enough for this project's volume.
# ---------------------------------------------------------------------------
# SERVER-ONLY.
RESEND_API_KEY=re_placeholder_replace_me
# Must be a domain you've verified in Resend, or their sandbox sender
# (onboarding@resend.dev) for local testing before a domain exists.
RESEND_FROM_EMAIL="Best Buddy UP! <onboarding@resend.dev>"
