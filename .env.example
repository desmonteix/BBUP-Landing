# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# ---------------------------------------------------------------------------
# Supabase (Project Settings -> API)
# ---------------------------------------------------------------------------
# Safe to expose in the browser bundle (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-ONLY. Bypasses Row Level Security entirely — never prefix with
# NEXT_PUBLIC_, never send to the client. Used by src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Culqi (https://apidocs.culqi.com/) — payments, sandbox/test mode until a
# real merchant account exists (spec: user hasn't created one yet).
# ---------------------------------------------------------------------------
# Public test key, safe in the browser bundle — loads the hosted Checkout
# widget. Get it from the Culqi dashboard once the merchant account exists;
# Culqi's docs list a shared sandbox test key for initial development.
NEXT_PUBLIC_CULQI_PUBLIC_KEY=pk_test_replace_me

# SERVER-ONLY. Used by src/lib/culqi.ts to create charges from the browser
# token. Never expose this.
CULQI_SECRET_KEY=sk_test_replace_me

# Shared secret you also set when registering the webhook URL in the Culqi
# dashboard (https://your-domain/api/culqi/webhook?secret=...). Placeholder
# scheme — see the VERIFICAR note in src/app/api/culqi/webhook/route.ts.
CULQI_WEBHOOK_SECRET=replace-with-a-long-random-string

# ---------------------------------------------------------------------------
# Resend (https://resend.com) — transactional email for RSVP/ticket
# confirmations. Free tier is enough for this project's volume.
# ---------------------------------------------------------------------------
# SERVER-ONLY.
RESEND_API_KEY=re_placeholder_replace_me
# Must be a domain you've verified in Resend, or their sandbox sender
# (onboarding@resend.dev) for local testing before a domain exists.
RESEND_FROM_EMAIL="Best Buddy UP! <onboarding@resend.dev>"
